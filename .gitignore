# 内置运行时：体积大，可重新下载
# 恢复方式：python.org 的 Windows embeddable package 解压到 python/，
# 再把 msvcp140.dll / vcruntime140.dll / vcruntime140_1.dll 放进 python/。
python/

# 本地工具（含本机 git 路径，不进公开仓库）
推送公开仓库.bat

# 系统文件
Thumbs.db
.DS_Store
desktop.ini

# 谱面数据集：脚本进仓库，抓下来的谱面与中间结果不进（体积大，可重新生成）
_dataset/data/
_dataset/.mma/
_dataset/*.jsonl
_dataset/*.csv
_dataset/crawl.log

# 临时工作目录（打包自检、一次性脚本、解压出来的包）
_tmp/

# 崩溃报告：本机排障产物，不进仓库也不进发行包
crashreport/
